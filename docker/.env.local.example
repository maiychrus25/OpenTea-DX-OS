# docker/.env.local.example
DATABASE_URL=postgresql://agrimarket:your_password_here@postgres:5432/agrimarket
KEYCLOAK_DB_PASSWORD=keycloak
POSTGRES_USER=agrimarket
POSTGRES_PASSWORD=your_password_here
# OLLAMA_MODEL: Model name for AI chatbot
# - Groq cloud (recommended): openai/gpt-oss-20b, llama-3.1-8b-instant
# - Ollama CPU-only fallback (<=500MB): qwen2:0.5b  <- use this if no GPU
# - Ollama with GPU: phi3:mini, llama3, mistral
OLLAMA_MODEL=openai/gpt-oss-20b
# OLLAMA_BASE_URL: URL of local Ollama service inside Docker network
# Default: http://ollama:11434 (docker) | http://localhost:11434 (local dev)
OLLAMA_BASE_URL=http://ollama:11434
GROQ_API_KEY=your_groq_api_key_here
AUTH_SECRET=your_nextauth_secret_here
KEYCLOAK_CLIENT_ID=nextjs-web
KEYCLOAK_CLIENT_SECRET=agrimarket-secret-key
KEYCLOAK_ISSUER=http://host.docker.internal:8080/realms/agrimarket
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=agrimarket-docs
DISEASE_API_URL=http://disease-api:8000
PIPER_URL=http://piper:5500
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
WTO_API_KEY=your_wto_api_key_here
COMTRADE_API_KEY=your_comtrade_api_key_here
MATTERMOST_WEBHOOK_URL=your_mattermost_webhook_url_here

HASURA_GRAPHQL_ADMIN_SECRET=change_me_hasura_admin_secret
# Public Keycloak issuer URL (the `iss` claim in tokens); change when Keycloak is served from a non-localhost hostname
KC_PUBLIC_ISSUER=http://localhost:8080/realms/agrimarket
# Public URL of the web app, used for the login redirect; it must be in the redirect URIs of the Keycloak client nextjs-web
AUTH_URL=http://localhost:3000

# MQTT broker accounts. DXOS_MQTT_DEVICES is a comma list of HTX_CODE:password device accounts (one per HTX);
# the release override refuses to start the broker while any password begins with change_me.
DXOS_MQTT_DEVICES=TC:change_me_mqtt_tc,LB:change_me_mqtt_lb
DXOS_MQTT_INGEST_PASSWORD=change_me_mqtt_ingest

# Keycloak bootstrap admin, read through Compose interpolation and only when its database is new. The release flow takes
# these from here via --env-file: replace both before the first start. Dev ignores them and stays on admin/admin, and the
# smoke test sources this file, so keep the dev values here matching that default.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional tuning, shown with defaults. Compose interpolates these, so they take effect through --env-file docker/.env.local
# in the release flow and through the shell or docker/.env in dev; setting them here does nothing in dev.
# Changing the model means changing both DXOS_LLM_MODEL and DXOS_LLM_MODEL_ID.
# DXOS_HOT_RETENTION_DAYS=30
# DXOS_LIFECYCLE_INTERVAL_SECONDS=3600
# DXOS_LLM_MODEL=qwen2.5:0.5b
# DXOS_LLM_MODEL_ID=a8b0c5157701
