[
  {
    "name": "weather question becomes the weather tool",
    "request": {
      "id": "req-weather",
      "text": "trời có mưa ở vùng mình không",
      "role": "farmer",
      "today": "2026-11-26",
      "tools": [
        {"name": "weather", "title_vi": "Thời tiết", "args": []},
        {"name": "journal", "title_vi": "Nhật ký", "args": []}
      ],
      "actions": [
        {"name": "journal.create", "title_vi": "Ghi nhật ký", "args": [
          {"name": "parcel_id", "type": "string", "descriptionVi": "Mã thửa, ví dụ TC-A1"},
          {"name": "activity_type", "type": "enum", "values": ["SPRAYING", "FERTILIZING", "IRRIGATION", "HARVEST", "SOWING", "OTHER"], "descriptionVi": "Loại hoạt động"},
          {"name": "product_name", "type": "string", "descriptionVi": "Tên thuốc hoặc phân bón"}
        ]},
        {"name": "journal.batch_approve", "title_vi": "Duyệt hàng loạt nhật ký", "args": []}
      ]
    },
    "replay_response": {"type": "tool", "name": "weather", "args": {}},
    "expected": {"intent": {"type": "tool", "name": "weather", "args": {}}, "run_status": "ok"}
  },
