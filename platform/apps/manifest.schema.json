{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentea.dev/dxos/v1/manifest.schema.json",
  "title": "DX-OS mini-app manifest (app.yaml)",
  "$comment": "SPDX-License-Identifier: MIT; SPDX-FileCopyrightText: 2026 OpenTea Developers",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "version", "license", "publisher", "requires", "runtime", "routes"],
  "$defs": {
    "route": { "type": "string", "pattern": "^/([a-z0-9_-]+(/[a-z0-9_-]+)*/?)?$" },
    "role": { "enum": ["farmer", "officer", "manager"] },
    "relativeDir": { "type": "string", "pattern": "^(\\.|[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/?)$" }
  },
  "properties": {
    "apiVersion": { "const": "dxos/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "license": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core"],
      "properties": { "core": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+$" } }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "health"],
      "oneOf": [{ "required": ["build"] }, { "required": ["image"] }],
      "properties": {
        "build": { "$ref": "#/$defs/relativeDir" },
        "image": { "type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": { "$ref": "#/$defs/route" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrations"],
      "properties": { "migrations": { "$ref": "#/$defs/relativeDir" } }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "public": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "protected": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/route" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/role" }
          }
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "enum": ["production", "sales", "members", "tourism", "sample"] },
        "icon": {
          "enum": ["leaf", "scale", "shopping-bag", "package", "map-pinned", "users", "calendar", "clipboard-list", "truck", "sparkles"]
        },
        "about": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "data": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "personal_data": { "type": "string", "minLength": 1, "maxLength": 300 },
        "core_reads": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "screenshots": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "caption"],
            "properties": {
              "file": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]{1,120}$" },
              "caption": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path", "roles"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "path": { "$ref": "#/$defs/route" },
          "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } }
        }
      }
    }
  }
}
