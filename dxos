#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 OpenTea Developers
# dxos: install, remove, list mini-apps and run the store worker (spec §5). The dxos-cli container does the manifest, gateway, journal
# and registry work; this script only starts and stops app containers, so no docker socket goes into a container.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# Same as the Makefile: runtime state is per compose project (R13), "docker" being compose's default for docker/.
PROJECT="${COMPOSE_PROJECT_NAME:-docker}"
RUNTIME="docker/runtime/$PROJECT"
# apisix reads the generated route file; relative to docker/, like every compose path.
export DXOS_GATEWAY_FILE="../$RUNTIME/gateway/apisix.yaml"
# Same as the Makefile: no build attestation, so rebuilding an unchanged app image keeps its ID and its container.
export BUILDX_NO_DEFAULT_ATTESTATIONS=1
ID_RE='^[a-z][a-z0-9-]{1,30}$'  # same as "id" in platform/apps/manifest.schema.json

usage() {
  echo "Dùng: ./dxos install <dir> | remove <id> [--purge] | list | validate <dir>... | worker" >&2
  exit 2
}

compose() { docker compose -f docker/docker-compose.yml "$@"; }
# APISIX mounts $RUNTIME/gateway/apisix.yaml; create the dirs before any container starts, as the Makefile does.
cli() {
  mkdir -p "$RUNTIME/gateway/apps" "$RUNTIME/apps"
  # Build first, quietly: `run --build` prints the build log on stdout, which install and list parse.
  compose --profile tools build --quiet dxos-cli >&2
  compose --profile tools run --rm -T --user "$(id -u):$(id -g)" dxos-cli "$@"
}
# Tells the store which phase a worker install is in; never lets a reporting failure fail the install.
progress() { [ -z "${DXOS_JOB:-}" ] || cli worker-progress "$DXOS_JOB" "$1" >/dev/null 2>&1 || true; }
app() { local id="$1"; shift; compose -f "$RUNTIME/apps/$id.compose.yml" "$@"; }
# Found by compose labels, so this also works for an orphan whose compose file is gone.
app_containers() {  # <id> [docker ps options]
  local id="$1"; shift
  docker ps -a "$@" --filter "label=com.docker.compose.project=$PROJECT" --filter "label=com.docker.compose.service=app-$id"
}
remove_container() {
  local ids
  ids="$(app_containers "$1" -q)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086  # container ids are hex, one per line
    docker stop $ids >/dev/null && docker rm $ids >/dev/null
  fi
}

# A hand-typed `docker compose up` recreates apisix on the base route file and every mini-app route answers 404 with no hint why.
gateway_guard() {
  local id src
  id="$(compose ps -q apisix 2>/dev/null)" || return 0
  [ -n "$id" ] || return 0  # no gateway yet: the next `make up` mounts the right file
  src="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/usr/local/apisix/conf/apisix.yaml"}}{{.Source}}{{end}}{{end}}' "$id" 2>/dev/null)" || return 0
  case "$src" in
    ""|*"/$RUNTIME/gateway/apisix.yaml") return 0 ;;  # suffix, not the absolute path: a symlinked checkout must not alarm
  esac
  echo "Cổng API đang đọc tệp route gốc chứ không phải $RUNTIME/gateway/apisix.yaml, nên route của mini-app không được nạp (thường do chạy docker compose trực tiếp, thiếu DXOS_GATEWAY_FILE). Chạy: make gateway-up" >&2
  exit 1
}

# Host directory (relative to the caller's cwd) -> the same directory inside dxos-cli, where the repo is /repo.
to_container() {
  local abs
  abs="$(cd -- "$1" 2>/dev/null && pwd -P)" || { echo "Không tìm thấy thư mục $1" >&2; exit 1; }
  case "$abs/" in
    "$ROOT/"*) printf '/repo%s\n' "${abs#"$ROOT"}" ;;
    *) echo "Thư mục app $1 phải nằm trong repo $ROOT" >&2; exit 1 ;;
  esac
}

# Undo a prepared install: the container first, then the journal's steps (route, compose file).
undo_install() {  # <id> <exit code>
  trap - INT TERM
  echo "Cài $1 hỏng hoặc bị ngắt; đang hoàn tác" >&2
  remove_container "$1" || true
  cli abort "$1" || true
  exit "$2"
}

install() {  # <dir> [all|htx]: "htx" leaves enabling to the store worker, "all" (default) enables for every HTX
  gateway_guard
  local dir="$1" mode="${2:-all}" id listing flag=""
  [ "$mode" != htx ] || flag=--no-enable-all
  id="$(cli manifest-id "$dir")" || exit 1  # validated by dxos-cli, so safe in a path and in the traps below
  listing="$(cli list)"  # captured, not piped: grep -q closing the pipe early would fail it under pipefail
  if grep -qxF "$id" <<<"$(cut -f1 <<<"$listing")"; then
    echo "$id đã được cài; chỉ bảo đảm container đang chạy"
    app "$id" up -d --wait "app-$id"
    return
  fi
  # Ctrl-C (or TERM) from here to commit must not leave a journal, route, schema or container behind. Set before
  # prepare, so an interrupt inside it is undone too; abort is a no-op when prepare had not written the journal yet.
  # shellcheck disable=SC2064  # expand the validated id now
  trap "undo_install $id 130" INT
  # shellcheck disable=SC2064
  trap "undo_install $id 143" TERM
  # prepare undoes its own steps when it fails; abort only retries an undo that failed (no-op otherwise).
  progress prepare
  cli prepare "$dir" || { cli abort "$id" || true; exit 1; }
  progress build
  # shellcheck disable=SC2086  # flag is empty or one option
  if app "$id" up -d --build --wait "app-$id" && { progress register; cli commit "$id" $flag; }; then
    trap - INT TERM
    echo "Đã cài $id"
    return
  fi
  undo_install "$id" 1
}

remove() {
  local id="$1"; shift
  [[ "$id" =~ $ID_RE ]] || { echo "id '$id' không hợp lệ" >&2; exit 1; }
  remove_container "$id"
  cli remove "$id" "$@"
}

list() {
  local out line id status
  out="$(cli list)"
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'* ]]; then
      id="${line%%$'\t'*}"
      status="$(app_containers "$id" --format '{{.Status}}')"
      line+=$'\t'"${status:-không có container}"
    fi
    printf '%s\n' "$line"
  done <<<"$out"
}

# Store worker (spec §6): runs the install and remove requests the App Store page queues in platform.app_requests.
# One worker per compose project, held by the directory $WORKER_LOCK (a pid file inside); a dead pid's lock is replaced.
WORKER_LOCK="$RUNTIME/worker.lock"
worker_log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
worker_release() { rm -rf "$WORKER_LOCK"; }

worker() {
  gateway_guard
  mkdir -p "$RUNTIME"
  if ! mkdir "$WORKER_LOCK" 2>/dev/null; then
    local old
    old="$(cat "$WORKER_LOCK/pid" 2>/dev/null || true)"
    if [[ "$old" =~ ^[0-9]+$ ]] && kill -0 "$old" 2>/dev/null; then
      echo "Một worker khác đang chạy (pid $old)." >&2
      exit 1
    fi
    # shortcut: two workers started in the same instant could both replace a stale lock; one operator, one worker.
    rm -rf "$WORKER_LOCK"
    mkdir "$WORKER_LOCK" || { echo "Không tạo được $WORKER_LOCK" >&2; exit 1; }
  fi
  echo $$ >"$WORKER_LOCK/pid"
  trap worker_release EXIT
  local stop=0 claim_pid="" claim_out id job action app htx installed rc dir remaining
  claim_out="$(mktemp)"
  # A signal between jobs ends the loop at once (the claim is killed); during a job it ends the loop afterwards.
  on_signal() { stop=1; [ -z "$claim_pid" ] || kill "$claim_pid" 2>/dev/null || true; }
  trap on_signal INT TERM

  # A crashed worker leaves a half install: the container and the journal go, the request is failed by worker-start.
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    remove_container "$id" || true
    cli abort "$id" >/dev/null 2>&1 || true
    worker_log "recovered half install of $id"
  done <<<"$(cli worker-start)"
  worker_log "worker started (pid $$, project $PROJECT)"

  while [ "$stop" = 0 ]; do
    : >"$claim_out"
    cli worker-claim --wait 30 >"$claim_out" &
    claim_pid=$!
    rc=0; wait "$claim_pid" || rc=$?
    claim_pid=""
    [ "$stop" = 0 ] || break
    if [ "$rc" != 0 ]; then worker_log "worker-claim failed (code $rc); retrying in 5 s"; sleep 5; continue; fi
    IFS=$'\t' read -r job action app htx installed <"$claim_out" || continue
    if [ "$action" = ENABLE ] && [ "$installed" = 0 ]; then
      # set -e is off inside a condition, so run the install in its own subshell with it switched on again.
      set +e
      ( set -e; DXOS_JOB="$job"; dir="$(to_container "miniapps/$app")" || exit 1; install "$dir" htx )
      rc=$?
      set -e
      if [ "$rc" = 130 ] || [ "$rc" = 143 ]; then  # interrupted: install undid itself; worker-start fails the request
        worker_log "job=$job action=$action app=$app htx=$htx result=interrupted"
        break
      elif [ "$rc" = 0 ]; then
        cli worker-finish "$job" ok >/dev/null
        worker_log "job=$job action=$action app=$app htx=$htx result=ok"
      else
        cli worker-finish "$job" fail "Cài đặt hỏng (mã $rc). Quản trị máy chủ xem nhật ký của ./dxos worker." >/dev/null
        worker_log "job=$job action=$action app=$app htx=$htx result=failed (code $rc)"
      fi
    elif [ "$action" = ENABLE ]; then
      cli worker-finish "$job" ok >/dev/null
      worker_log "job=$job action=$action app=$app htx=$htx result=ok (already installed)"
    else
      remaining="$(cli worker-finish "$job" ok)"
      worker_log "job=$job action=$action app=$app htx=$htx result=ok ($remaining)"
      if [ "$remaining" = remaining=0 ]; then
        if ( remove "$app" ) >/dev/null; then
          worker_log "removed $app (no cooperative left)"
        else
          worker_log "removing $app failed; it stays installed with no cooperative enabled"
        fi
      fi
    fi
  done
  rm -f "$claim_out"
  worker_log "worker stopped"
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  install)
    [ $# -eq 1 ] || usage
    dir="$(to_container "$1")"; cd "$ROOT"; install "$dir" ;;
  remove)
    [ $# -ge 1 ] || usage
    cd "$ROOT"; remove "$@" ;;
  list)
    [ $# -eq 0 ] || usage
    cd "$ROOT"; list ;;
  validate)
    [ $# -ge 1 ] || usage
    dirs=(); for d in "$@"; do c="$(to_container "$d")"; dirs+=("$c"); done
    cd "$ROOT"; cli validate "${dirs[@]}" ;;
  worker)
    [ $# -eq 0 ] || usage
    cd "$ROOT"; worker ;;
  *) usage ;;
esac
