#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 OpenTea Developers
# dxos: install, remove, list mini-apps and run the store worker (spec §5). The dxos-cli container does the manifest, gateway, journal
# and registry work; this script only starts and stops app containers, so no docker socket goes into a container.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# Same as the Makefile: runtime state is per compose project (R13), "docker" being compose's default for docker/.
PROJECT="${COMPOSE_PROJECT_NAME:-docker}"
RUNTIME="docker/runtime/$PROJECT"
# apisix reads the generated route file; relative to docker/, like every compose path.
export DXOS_GATEWAY_FILE="../$RUNTIME/gateway/apisix.yaml"
# Same as the Makefile: no build attestation, so rebuilding an unchanged app image keeps its ID and its container.
export BUILDX_NO_DEFAULT_ATTESTATIONS=1
ID_RE='^[a-z][a-z0-9-]{1,30}$'  # same as "id" in platform/apps/manifest.schema.json
HTX_RE='^[A-Z0-9_-]{1,20}$'

usage() {
  echo "Dùng: ./dxos install <dir> | upgrade <dir> | remove <id> [--purge] | list | validate <dir>... | worker | builder [--once] | agent <enable|disable> <HTX> | staff <enable|disable> <HTX> | telegram <enable|disable> | apps actor enable" >&2
  exit 2
}

compose() { docker compose -f docker/docker-compose.yml "$@"; }
# APISIX mounts $RUNTIME/gateway/apisix.yaml; create the dirs before any container starts, as the Makefile does.
cli() {
  mkdir -p "$RUNTIME/gateway/apps" "$RUNTIME/apps"
  # Build first, quietly: `run --build` prints the build log on stdout, which install and list parse.
  compose --profile tools build --quiet dxos-cli >&2
  compose --profile tools run --rm -T --user "$(id -u):$(id -g)" dxos-cli "$@"
}
# Tells the store which phase a worker install is in; never lets a reporting failure fail the install.
progress() { [ -z "${DXOS_JOB:-}" ] || cli worker-progress "$DXOS_JOB" "$1" >/dev/null 2>&1 || true; }
app() { local id="$1"; shift; compose -f "$RUNTIME/apps/$id.compose.yml" "$@"; }
# Found by compose labels, so this also works for an orphan whose compose file is gone.
app_containers() {  # <id> [docker ps options]
  local id="$1"; shift
  docker ps -a "$@" --filter "label=com.docker.compose.project=$PROJECT" --filter "label=com.docker.compose.service=app-$id"
}
remove_container() {
  local ids
  ids="$(app_containers "$1" -q)"
  if [ -n "$ids" ]; then
    # shellcheck disable=SC2086  # container ids are hex, one per line
    docker stop $ids >/dev/null && docker rm $ids >/dev/null
  fi
}

# A hand-typed `docker compose up` recreates apisix on the base route file and every mini-app route answers 404 with no hint why.
gateway_guard() {
  local id src
  id="$(compose ps -q apisix 2>/dev/null)" || return 0
  [ -n "$id" ] || return 0  # no gateway yet: the next `make up` mounts the right file
  src="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/usr/local/apisix/conf/apisix.yaml"}}{{.Source}}{{end}}{{end}}' "$id" 2>/dev/null)" || return 0
  case "$src" in
    ""|*"/$RUNTIME/gateway/apisix.yaml") return 0 ;;  # suffix, not the absolute path: a symlinked checkout must not alarm
  esac
  echo "Cổng API đang đọc tệp route gốc chứ không phải $RUNTIME/gateway/apisix.yaml, nên route của mini-app không được nạp (thường do chạy docker compose trực tiếp, thiếu DXOS_GATEWAY_FILE). Chạy: make gateway-up" >&2
  exit 1
}

# A generated app's private network (spec 12.7) holds the app, apisix and postgres. The compose file creates it with the
# app and names apisix and postgres, but only a recreate would apply that, so the running containers are joined here.
# shortcut: recreating apisix or postgres drops the join; ./dxos worker, install and upgrade put it back.
gen_network_connect() {  # <id>
  case "$1" in gen-*) ;; *) return 0 ;; esac
  local svc cid
  for svc in apisix postgres; do
    cid="$(compose ps -q "$svc" 2>/dev/null)" || continue
    [ -z "$cid" ] || docker network connect "${PROJECT}_dxos-gen-$1" "$cid" 2>/dev/null || true  # "already exists" is fine
  done
}
gen_network_drop() {  # <id>
  case "$1" in gen-*) ;; *) return 0 ;; esac
  local svc cid
  for svc in apisix postgres; do
    cid="$(compose ps -q "$svc" 2>/dev/null)" || continue
    [ -z "$cid" ] || docker network disconnect "${PROJECT}_dxos-gen-$1" "$cid" 2>/dev/null || true
  done
  docker network rm "${PROJECT}_dxos-gen-$1" >/dev/null 2>&1 || true
}

# Host directory (relative to the caller's cwd) -> the same directory inside dxos-cli, where the repo is /repo.
to_container() {
  local abs
  abs="$(cd -- "$1" 2>/dev/null && pwd -P)" || { echo "Không tìm thấy thư mục $1" >&2; exit 1; }
  case "$abs/" in
    "$ROOT/"*) printf '/repo%s\n' "${abs#"$ROOT"}" ;;
    *) echo "Thư mục app $1 phải nằm trong repo $ROOT" >&2; exit 1 ;;
  esac
}

# Undo a prepared install: the container first, then the journal's steps (route, compose file).
undo_install() {  # <id> <exit code>
  trap - INT TERM
  echo "Cài $1 hỏng hoặc bị ngắt; đang hoàn tác" >&2
  remove_container "$1" || true
  cli abort "$1" || true
  exit "$2"
}

install() {  # <dir> [all|htx]: "htx" leaves enabling to the store worker, "all" (default) enables for every HTX
  gateway_guard
  local dir="$1" mode="${2:-all}" id listing flag=""
  [ "$mode" != htx ] || flag=--no-enable-all
  id="$(cli manifest-id "$dir")" || exit 1  # validated by dxos-cli, so safe in a path and in the traps below
  listing="$(cli list)"  # captured, not piped: grep -q closing the pipe early would fail it under pipefail
  if grep -qxF "$id" <<<"$(cut -f1 <<<"$listing")"; then
    echo "$id đã được cài; chỉ bảo đảm container đang chạy"
    app "$id" up -d --wait "app-$id"
    gen_network_connect "$id"
    return
  fi
  # Ctrl-C (or TERM) from here to commit must not leave a journal, route, schema or container behind. Set before
  # prepare, so an interrupt inside it is undone too; abort is a no-op when prepare had not written the journal yet.
  # shellcheck disable=SC2064  # expand the validated id now
  trap "undo_install $id 130" INT
  # shellcheck disable=SC2064
  trap "undo_install $id 143" TERM
  # prepare undoes its own steps when it fails; abort only retries an undo that failed (no-op otherwise).
  progress prepare
  cli prepare "$dir" || { cli abort "$id" || true; exit 1; }
  progress build
  # shellcheck disable=SC2086  # flag is empty or one option
  if app "$id" up -d --build --wait "app-$id" && { gen_network_connect "$id"; progress register; cli commit "$id" $flag; }; then
    trap - INT TERM
    echo "Đã cài $id"
    return
  fi
  undo_install "$id" 1
}

# Upgrade a registered app in place: new code, route and pending migrations; enablements are never touched.
# A failure leaves the registry on the old version (commit comes last); the next upgrade rewrites route and compose file.
upgrade() {  # <dir>
  gateway_guard
  local dir="$1" id old new
  id="$(cli manifest-id "$dir")" || exit 1
  old="$(cli list | awk -F'\t' -v id="$id" '$1 == id { print $2 }')"
  if cli upgrade-prepare "$dir" && app "$id" up -d --build --wait "app-$id" && { gen_network_connect "$id"; cli upgrade-commit "$id"; }; then
    new="$(cli list | awk -F'\t' -v id="$id" '$1 == id { print $2 }')"
    echo "Đã nâng cấp $id lên $new"
    return
  fi
  echo "Nâng cấp $id hỏng; bản đang đăng ký vẫn là ${old:-không rõ}" >&2
  exit 1
}

remove() {
  local id="$1"; shift
  [[ "$id" =~ $ID_RE ]] || { echo "id '$id' không hợp lệ" >&2; exit 1; }
  remove_container "$id"
  gen_network_drop "$id"
  cli remove "$id" "$@"
}

list() {
  local out line id status
  out="$(cli list)"
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'* ]]; then
      id="${line%%$'\t'*}"
      status="$(app_containers "$id" --format '{{.Status}}')"
      line+=$'\t'"${status:-không có container}"
    fi
    printf '%s\n' "$line"
  done <<<"$out"
}

# Store worker (spec §6): runs the install and remove requests the App Store page queues in platform.app_requests.
# One worker per compose project, held by the directory $WORKER_LOCK (a pid file inside); a dead pid's lock is replaced.
WORKER_LOCK="$RUNTIME/worker.lock"
worker_log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
worker_release() { rm -rf "$WORKER_LOCK"; }

worker() {
  gateway_guard
  mkdir -p "$RUNTIME"
  if ! mkdir "$WORKER_LOCK" 2>/dev/null; then
    local old
    old="$(cat "$WORKER_LOCK/pid" 2>/dev/null || true)"
    if [[ "$old" =~ ^[0-9]+$ ]] && kill -0 "$old" 2>/dev/null; then
      echo "Một worker khác đang chạy (pid $old)." >&2
      exit 1
    fi
    # shortcut: two workers started in the same instant could both replace a stale lock; one operator, one worker.
    rm -rf "$WORKER_LOCK"
    mkdir "$WORKER_LOCK" || { echo "Không tạo được $WORKER_LOCK" >&2; exit 1; }
  fi
  echo $$ >"$WORKER_LOCK/pid"
  trap worker_release EXIT
  local stop=0 claim_pid="" claim_out id job action app htx installed version rc dir remaining
  claim_out="$(mktemp)"
  # A signal between jobs ends the loop at once (the claim is killed); during a job it ends the loop afterwards.
  on_signal() { stop=1; [ -z "$claim_pid" ] || kill "$claim_pid" 2>/dev/null || true; }
  trap on_signal INT TERM

  # A crashed worker leaves a half install: the container and the journal go, the request is failed by worker-start.
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    remove_container "$id" || true
    cli abort "$id" >/dev/null 2>&1 || true
    worker_log "recovered half install of $id"
  done <<<"$(cli worker-start)"
  for id in $(cli list | awk -F'\t' '$1 ~ /^gen-/ { print $1 }'); do gen_network_connect "$id"; done
  worker_log "worker started (pid $$, project $PROJECT)"

  while [ "$stop" = 0 ]; do
    : >"$claim_out"
    cli worker-claim --wait 30 >"$claim_out" &
    claim_pid=$!
    rc=0; wait "$claim_pid" || rc=$?
    claim_pid=""
    [ "$stop" = 0 ] || break
    if [ "$rc" != 0 ]; then worker_log "worker-claim failed (code $rc); retrying in 5 s"; sleep 5; continue; fi
    version=""
    IFS=$'\t' read -r job action app htx installed version <"$claim_out" || continue
    if [ "$action" = ENABLE ] && [ "$installed" = 0 ]; then
      # set -e is off inside a condition, so run the install in its own subshell with it switched on again.
      set +e
      ( set -e; DXOS_JOB="$job"; if [ -n "$version" ]; then dir="/repo/docker/runtime/generated/$app/$version"; else dir="$(to_container "miniapps/$app")" || exit 1; fi; install "$dir" htx )
      rc=$?
      set -e
      if [ "$rc" = 130 ] || [ "$rc" = 143 ]; then  # interrupted: install undid itself; worker-start fails the request
        worker_log "job=$job action=$action app=$app htx=$htx result=interrupted"
        break
      elif [ "$rc" = 0 ]; then
        cli worker-finish "$job" ok >/dev/null
        worker_log "job=$job action=$action app=$app htx=$htx result=ok"
      else
        cli worker-finish "$job" fail "Cài đặt hỏng (mã $rc). Quản trị máy chủ xem nhật ký của ./dxos worker." >/dev/null
        worker_log "job=$job action=$action app=$app htx=$htx result=failed (code $rc)"
      fi
    elif [ "$action" = ENABLE ]; then
      cli worker-finish "$job" ok >/dev/null
      worker_log "job=$job action=$action app=$app htx=$htx result=ok (already installed)"
    else
      remaining="$(cli worker-finish "$job" ok)"
      worker_log "job=$job action=$action app=$app htx=$htx result=ok ($remaining)"
      if [ "$remaining" = remaining=0 ]; then
        if ( remove "$app" ) >/dev/null; then
          worker_log "removed $app (no cooperative left)"
        else
          worker_log "removing $app failed; it stays installed with no cooperative enabled"
        fi
      fi
    fi
  done
  rm -f "$claim_out"
  worker_log "worker stopped"
}

# Mini-app factory loop (plan M13): runs approved build requests, one at a time, in throwaway containers (platform/builder/loop.py).
# One per compose project, held by the directory $BUILDER_LOCK, like the store worker.
BUILDER_LOCK="$RUNTIME/builder.lock"
builder_release() { rm -rf "$BUILDER_LOCK"; }

builder() {
  gateway_guard
  command -v python3 >/dev/null || { echo "./dxos builder cần python3 trên máy chủ" >&2; exit 1; }
  mkdir -p "$RUNTIME"
  if ! mkdir "$BUILDER_LOCK" 2>/dev/null; then
    local old
    old="$(cat "$BUILDER_LOCK/pid" 2>/dev/null || true)"
    if [[ "$old" =~ ^[0-9]+$ ]] && kill -0 "$old" 2>/dev/null; then
      echo "Một vòng xây khác đang chạy (pid $old)." >&2
      exit 1
    fi
    rm -rf "$BUILDER_LOCK"
    mkdir "$BUILDER_LOCK" || { echo "Không tạo được $BUILDER_LOCK" >&2; exit 1; }
  fi
  echo $$ >"$BUILDER_LOCK/pid"
  trap builder_release EXIT
  COMPOSE_PROJECT_NAME="$PROJECT" python3 platform/builder/loop.py "$@"
}

kc_exec() {
  local script="$1"; shift
  compose exec -T keycloak sh -c "$script" sh "$@"
}

# The agent reads its credentials from the dxos-agent-env volume as uid 10001. The tools helper runs as root with no network;
# the secret comes on stdin, never in argv.
agent_env_write() {  # <file name>: content on stdin
  compose --profile tools run --rm -T --no-deps dxos-agent-env \
    sh -c 'umask 077 && cat > "/run/dxos-agent/$1" && chown 10001:10001 "/run/dxos-agent/$1" && chmod 600 "/run/dxos-agent/$1"' sh "$1"
}
agent_env_remove() {  # <file name>
  compose --profile tools run --rm -T --no-deps dxos-agent-env rm -f "/run/dxos-agent/$1"
}

agent_enable() {
  local htx="$1" htx_lower client_id secret found
  [[ "$htx" =~ $HTX_RE ]] || { echo "Mã HTX '$htx' không hợp lệ (chỉ gồm A-Z, 0-9, _, -, tối đa 20 ký tự)" >&2; exit 1; }
  htx_lower="$(printf '%s' "$htx" | tr '[:upper:]' '[:lower:]')"
  client_id="dxos-agent-$htx_lower"
  # Checked before Keycloak is touched, so an unknown cooperative leaves no client behind.
  found="$(compose exec -T postgres psql -U agrimarket -d agrimarket -tA -v ON_ERROR_STOP=1 -v "htx=$htx" <<'SQL'
SELECT 1 FROM htx_profiles WHERE htx_code = :'htx';
SQL
)"
  [ "$found" = 1 ] || { echo "Không có HTX $htx trong bảng htx_profiles; hãy tạo HTX trước khi bật lớp AI" >&2; exit 1; }

  secret="$(kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    HTX="$1"
    CLIENT_ID="$2"
    SA_USER="service-account-$CLIENT_ID"
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    if ! "$K" get roles/agent -r agrimarket >/dev/null 2>&1; then
      "$K" create roles -r agrimarket -s name=agent -s "description=AI operational agent" >/dev/null
    fi
    CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    if [ -z "$CID" ]; then
      "$K" create clients -r agrimarket \
        -s "clientId=$CLIENT_ID" -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true \
        -s standardFlowEnabled=false -s implicitFlowEnabled=false -s directAccessGrantsEnabled=false \
        -s "defaultClientScopes=[\"roles\",\"dx-os-core\"]" -s "optionalClientScopes=[]" >/dev/null
      CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    fi
    UID_SA="$("$K" get "clients/$CID/service-account-user" -r agrimarket --fields id --format csv --noquotes | head -n 1)"
    "$K" update "users/$UID_SA" -r agrimarket -s "attributes.htx_code=[\"$HTX\"]" >/dev/null
    "$K" add-roles -r agrimarket --uusername "$SA_USER" --rolename agent >/dev/null
    "$K" get "clients/$CID/client-secret" -r agrimarket --fields value --format csv --noquotes | head -n 1
  ' "$htx" "$client_id")"

  [ -n "$secret" ] || { echo "Không lấy được client secret cho $client_id" >&2; exit 1; }
  printf 'DXOS_AGENT_CLIENT_ID=%s\nDXOS_AGENT_CLIENT_SECRET=%s\nDXOS_AGENT_HTX=%s\n' "$client_id" "$secret" "$htx" | agent_env_write "$htx.env"

  compose exec -T postgres psql -U agrimarket -d agrimarket -v ON_ERROR_STOP=1 -v "htx=$htx" -q <<'SQL' >/dev/null
INSERT INTO platform.agent_settings (htx_code, agent, enabled)
VALUES (:'htx', 'journal-review', true)
ON CONFLICT (htx_code, agent) DO UPDATE SET enabled = true;
SQL
  echo "Đã bật lớp AI cho HTX $htx"
}

agent_disable() {
  local htx="$1" htx_lower client_id
  [[ "$htx" =~ $HTX_RE ]] || { echo "Mã HTX '$htx' không hợp lệ" >&2; exit 1; }
  htx_lower="$(printf '%s' "$htx" | tr '[:upper:]' '[:lower:]')"
  client_id="dxos-agent-$htx_lower"

  kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    CLIENT_ID="$1"
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    if [ -n "$CID" ]; then
      "$K" delete "clients/$CID" -r agrimarket >/dev/null
    fi
  ' "$client_id"

  agent_env_remove "$htx.env"
  compose exec -T postgres psql -U agrimarket -d agrimarket -v ON_ERROR_STOP=1 -v "htx=$htx" -q <<'SQL' >/dev/null
UPDATE platform.agent_settings SET enabled = false WHERE htx_code = :'htx';
UPDATE platform.agent_proposals SET status = 'expired' WHERE htx_code = :'htx' AND status = 'proposed';
SQL
  echo "Đã tắt lớp AI cho HTX $htx"
}

# The staff app (D14) pulls tasks with its own per-cooperative client. Its secret is typed into the staff app's settings by the
# operator, so it is printed once here and written nowhere else.
staff_enable() {
  local htx="$1" htx_lower client_id secret found
  [[ "$htx" =~ $HTX_RE ]] || { echo "Mã HTX '$htx' không hợp lệ (chỉ gồm A-Z, 0-9, _, -, tối đa 20 ký tự)" >&2; exit 1; }
  htx_lower="$(printf '%s' "$htx" | tr '[:upper:]' '[:lower:]')"
  client_id="dxos-staff-$htx_lower"
  # Checked before Keycloak is touched, so an unknown cooperative leaves no client behind.
  found="$(compose exec -T postgres psql -U agrimarket -d agrimarket -tA -v ON_ERROR_STOP=1 -v "htx=$htx" <<'SQL'
SELECT 1 FROM htx_profiles WHERE htx_code = :'htx';
SQL
)"
  [ "$found" = 1 ] || { echo "Không có HTX $htx trong bảng htx_profiles; hãy tạo HTX trước khi bật app nhân sự" >&2; exit 1; }

  secret="$(kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    HTX="$1"
    CLIENT_ID="$2"
    SA_USER="service-account-$CLIENT_ID"
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    if ! "$K" get roles/staff-sync -r agrimarket >/dev/null 2>&1; then
      "$K" create roles -r agrimarket -s name=staff-sync -s "description=Staff app sync" >/dev/null
    fi
    CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    if [ -z "$CID" ]; then
      "$K" create clients -r agrimarket \
        -s "clientId=$CLIENT_ID" -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true \
        -s standardFlowEnabled=false -s implicitFlowEnabled=false -s directAccessGrantsEnabled=false \
        -s "defaultClientScopes=[\"roles\",\"dx-os-core\"]" -s "optionalClientScopes=[]" >/dev/null
      CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    fi
    UID_SA="$("$K" get "clients/$CID/service-account-user" -r agrimarket --fields id --format csv --noquotes | head -n 1)"
    "$K" update "users/$UID_SA" -r agrimarket -s "attributes.htx_code=[\"$HTX\"]" >/dev/null
    "$K" add-roles -r agrimarket --uusername "$SA_USER" --rolename staff-sync >/dev/null
    "$K" get "clients/$CID/client-secret" -r agrimarket --fields value --format csv --noquotes | head -n 1
  ' "$htx" "$client_id")"

  [ -n "$secret" ] || { echo "Không lấy được client secret cho $client_id" >&2; exit 1; }
  echo "Đã bật app nhân sự cho HTX $htx. Nhập các giá trị này vào mục 'Kết nối hệ thống lõi' trong cài đặt app nhân sự:"
  echo "  Client id: $client_id"
  echo "  Secret: $secret"
  echo "  Địa chỉ Keycloak (app lấy token tại <địa chỉ>/realms/agrimarket/protocol/openid-connect/token): http://localhost:8080"
  echo "  Địa chỉ cổng lõi (gateway công khai): http://localhost:9080"
  echo "  (Từ máy khác, thay localhost bằng địa chỉ của máy chủ lõi.)"
}

staff_disable() {
  local htx="$1" htx_lower client_id
  [[ "$htx" =~ $HTX_RE ]] || { echo "Mã HTX '$htx' không hợp lệ" >&2; exit 1; }
  htx_lower="$(printf '%s' "$htx" | tr '[:upper:]' '[:lower:]')"
  client_id="dxos-staff-$htx_lower"

  kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    CLIENT_ID="$1"
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
    if [ -n "$CID" ]; then
      "$K" delete "clients/$CID" -r agrimarket >/dev/null
    fi
  ' "$client_id"
  echo "Đã tắt app nhân sự cho HTX $htx"
}

# Telegram relay credentials: dxos-telegram reads its file from dxos-telegram-env, dxos-web reads roles.env from dxos-web-env.
telegram_env_write() {  # <dir in the helper> <file name>: content on stdin
  compose --profile tools run --rm -T --no-deps dxos-telegram-env \
    sh -c 'umask 077 && cat > "$1/$2" && chown 10001:10001 "$1/$2" && chmod 600 "$1/$2"' sh "$1" "$2"
}
telegram_env_remove() {  # <dir in the helper> <file name>
  compose --profile tools run --rm -T --no-deps dxos-telegram-env rm -f "$1/$2"
}
# A running relay keeps the credentials it started with; restart it so the new ones (or none) take effect.
telegram_restart() {
  if [ -n "$(compose ps -q dxos-telegram 2>/dev/null)" ]; then compose restart dxos-telegram >/dev/null; fi
}

# roles.env holds one web credential per feature (the roles client, the apps actor), so a feature changes only its own keys.
roles_env_read() { compose --profile tools run --rm -T --no-deps dxos-telegram-env sh -c 'cat /run/dxos-web/roles.env 2>/dev/null || true' </dev/null; }
roles_env_update() {  # <KEY>...: drops these keys from roles.env, then adds the lines on stdin; an empty result removes the file
  local added rest
  added="$(cat)"
  rest="$({ roles_env_read | grep -Ev "^($(IFS='|'; echo "$*"))=|^$" || true; printf '%s\n' "$added"; } | grep -v '^$' || true)"
  if [ -n "$rest" ]; then printf '%s\n' "$rest" | telegram_env_write /run/dxos-web roles.env; else telegram_env_remove /run/dxos-web roles.env; fi
}

# C1: the web validates Mini App initData with HMAC_SHA256(key="WebAppData", msg=<bot token>), never with the token itself.
# The token comes from the environment or docker/.env.local; prints nothing when there is none (Telegram stays chat-only).
telegram_webapp_key() {
  local token="${TELEGRAM_BOT_TOKEN:-}"
  [ -n "$token" ] || token="$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' docker/.env.local 2>/dev/null | tail -n 1 | tr -d '\r"'"'" || true)"
  [ -n "$token" ] || return 0
  TG_TOKEN="$token" python3 -c 'import hashlib, hmac, os; print(hmac.new(b"WebAppData", os.environ["TG_TOKEN"].encode(), hashlib.sha256).hexdigest())'
}

telegram_enable() {
  local secrets telegram_secret roles_secret webapp_key
  # One Keycloak script makes both clients; it prints the telegram client secret, then the roles client secret.
  secrets="$(kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    TG_SCOPES="$1"
    RL_SCOPES="$2"
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    if ! "$K" get roles/telegram -r agrimarket >/dev/null 2>&1; then
      "$K" create roles -r agrimarket -s name=telegram -s "description=Rơle Telegram (client credentials, chỉ gọi /api/internal/telegram/*)" >/dev/null
    fi
    ensure_client() {  # <clientId> <default scopes json>: creates the confidential service-account client if missing, prints its id
      local cid
      cid="$("$K" get clients -r agrimarket -q "clientId=$1" --fields id --format csv --noquotes | head -n 1)"
      if [ -z "$cid" ]; then
        "$K" create clients -r agrimarket \
          -s "clientId=$1" -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true \
          -s standardFlowEnabled=false -s implicitFlowEnabled=false -s directAccessGrantsEnabled=false \
          -s "defaultClientScopes=$2" -s "optionalClientScopes=[]" >/dev/null
        cid="$("$K" get clients -r agrimarket -q "clientId=$1" --fields id --format csv --noquotes | head -n 1)"
      fi
      printf "%s" "$cid"
    }
    client_secret() {  # <clientId> <clientuuid>
      "$K" get "clients/$2/client-secret" -r agrimarket --fields value --format csv --noquotes | head -n 1
    }
    TG_CID="$(ensure_client dxos-telegram "$TG_SCOPES")"
    "$K" add-roles -r agrimarket --uusername service-account-dxos-telegram --rolename telegram >/dev/null
    client_secret dxos-telegram "$TG_CID"
    RL_CID="$(ensure_client dxos-web-roles "$RL_SCOPES")"
    "$K" add-roles -r agrimarket --uusername service-account-dxos-web-roles --cclientid realm-management --rolename view-users >/dev/null
    client_secret dxos-web-roles "$RL_CID"
  ' '["roles","dx-os-core"]' '["roles"]')"
  telegram_secret="$(sed -n 1p <<<"$secrets")"
  roles_secret="$(sed -n 2p <<<"$secrets")"
  [ -n "$telegram_secret" ] && [ -n "$roles_secret" ] || { echo "Không lấy được client secret của Telegram" >&2; exit 1; }
  printf 'DXOS_TELEGRAM_CLIENT_ID=dxos-telegram\nDXOS_TELEGRAM_CLIENT_SECRET=%s\n' "$telegram_secret" | telegram_env_write /run/dxos-telegram telegram.env
  webapp_key="$(telegram_webapp_key)"
  { printf 'DXOS_ROLES_CLIENT_ID=dxos-web-roles\nDXOS_ROLES_CLIENT_SECRET=%s\n' "$roles_secret"
    [ -z "$webapp_key" ] || printf 'DXOS_TELEGRAM_WEBAPP_KEY=%s\n' "$webapp_key"; } \
    | roles_env_update DXOS_ROLES_CLIENT_ID DXOS_ROLES_CLIENT_SECRET DXOS_TELEGRAM_WEBAPP_KEY
  telegram_restart
  echo "Đã bật Telegram: client dxos-telegram và dxos-web-roles (cần TELEGRAM_BOT_TOKEN trong docker/.env.local để rơle nhận tin)"
}

# The web runs an approved mini-app action as the approver with this client's token (M9). Safe to repeat: the client is kept.
apps_actor_enable() {
  local secret
  secret="$(kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    CID="$("$K" get clients -r agrimarket -q "clientId=dxos-apps-actor" --fields id --format csv --noquotes | head -n 1)"
    if [ -z "$CID" ]; then
      "$K" create clients -r agrimarket \
        -s clientId=dxos-apps-actor -s enabled=true -s publicClient=false -s serviceAccountsEnabled=true \
        -s standardFlowEnabled=false -s implicitFlowEnabled=false -s directAccessGrantsEnabled=false \
        -s "defaultClientScopes=[\"dx-os-core\"]" -s "optionalClientScopes=[]" >/dev/null
      CID="$("$K" get clients -r agrimarket -q "clientId=dxos-apps-actor" --fields id --format csv --noquotes | head -n 1)"
    fi
    "$K" get "clients/$CID/client-secret" -r agrimarket --fields value --format csv --noquotes | head -n 1
  ')"
  [ -n "$secret" ] || { echo "Không lấy được client secret của dxos-apps-actor" >&2; exit 1; }
  printf 'DXOS_APPS_ACTOR_SECRET=%s\n' "$secret" | roles_env_update DXOS_APPS_ACTOR_SECRET
  echo "Đã bật hành động của mini-app: client dxos-apps-actor (web đọc secret từ roles.env, không cần khởi động lại)"
}

telegram_disable() {
  kc_exec '
    set -eu
    K=/opt/keycloak/bin/kcadm.sh
    "$K" config credentials --server http://localhost:8080 --realm master --user "$KEYCLOAK_ADMIN" --password "$KEYCLOAK_ADMIN_PASSWORD" >/dev/null
    for CLIENT_ID in dxos-telegram dxos-web-roles; do
      CID="$("$K" get clients -r agrimarket -q "clientId=$CLIENT_ID" --fields id --format csv --noquotes | head -n 1)"
      if [ -n "$CID" ]; then
        "$K" delete "clients/$CID" -r agrimarket >/dev/null
      fi
    done
  '
  telegram_env_remove /run/dxos-telegram telegram.env
  roles_env_update DXOS_ROLES_CLIENT_ID DXOS_ROLES_CLIENT_SECRET DXOS_TELEGRAM_WEBAPP_KEY </dev/null
  telegram_restart
  echo "Đã tắt Telegram: đã xoá client dxos-telegram và dxos-web-roles"
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  install)
    [ $# -eq 1 ] || usage
    dir="$(to_container "$1")"; cd "$ROOT"; install "$dir" ;;
  upgrade)
    [ $# -eq 1 ] || usage
    dir="$(to_container "$1")"; cd "$ROOT"; upgrade "$dir" ;;
  remove)
    [ $# -ge 1 ] || usage
    cd "$ROOT"; remove "$@" ;;
  list)
    [ $# -eq 0 ] || usage
    cd "$ROOT"; list ;;
  validate)
    [ $# -ge 1 ] || usage
    dirs=(); for d in "$@"; do c="$(to_container "$d")"; dirs+=("$c"); done
    cd "$ROOT"; cli validate "${dirs[@]}" ;;
  worker)
    [ $# -eq 0 ] || usage
    cd "$ROOT"; worker ;;
  builder)
    [ $# -le 1 ] && { [ $# -eq 0 ] || [ "$1" = --once ]; } || usage
    cd "$ROOT"; builder "$@" ;;
  agent)
    [ $# -eq 2 ] || usage
    subcmd="$1"; htx="$2"
    case "$subcmd" in
      enable) cd "$ROOT"; agent_enable "$htx" ;;
      disable) cd "$ROOT"; agent_disable "$htx" ;;
      *) usage ;;
    esac ;;
  staff)
    [ $# -eq 2 ] || usage
    subcmd="$1"; htx="$2"
    case "$subcmd" in
      enable) cd "$ROOT"; staff_enable "$htx" ;;
      disable) cd "$ROOT"; staff_disable "$htx" ;;
      *) usage ;;
    esac ;;
  telegram)
    [ $# -eq 1 ] || usage
    subcmd="$1"
    case "$subcmd" in
      enable) cd "$ROOT"; telegram_enable ;;
      disable) cd "$ROOT"; telegram_disable ;;
      *) usage ;;
    esac ;;
  apps)
    [ $# -eq 2 ] && [ "$1" = actor ] && [ "$2" = enable ] || usage
    cd "$ROOT"; apps_actor_enable ;;
  *) usage ;;
esac
