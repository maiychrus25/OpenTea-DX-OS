<Window x:Class="TeaIot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt trạm" Width="760" Height="760" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding Error, Converter={StaticResource Visible}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Huỷ" Command="{Binding CancelCommand}" Margin="0,0,8,0" Width="96" />
                <Button Style="{StaticResource PrimaryButton}" Content="Lưu" Command="{Binding SaveCommand}" Width="96" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Kết nối lõi DX-OS (MQTT)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Tài khoản thiết bị là mã HTX; mật khẩu lấy ở DXOS_MQTT_DEVICES trong docker/.env.local của lõi. Broker chỉ cho tài khoản này ghi vào htx/&lt;mã HTX&gt;/plot/…" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mã HTX" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding HtxCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tên HTX" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding HtxName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Địa chỉ broker" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BrokerHost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cổng" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BrokerPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Mật khẩu thiết bị" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BrokerPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Chu kỳ đo (giây)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phút mô phỏng mỗi lần đo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SimMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gửi cảnh báo sang Tea Staff Manager" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Đất khô, sương muối… thành gợi ý giao việc trong app quản lý nhân sự; khoá thiết bị phải trùng khoá trong Cài đặt của app đó. Để trống địa chỉ để tắt." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Địa chỉ Tea Staff Manager" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StaffApiUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Khoá thiết bị" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StaffDeviceKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="32" Content="Thêm trạm" Command="{Binding AddStationCommand}" />
                            <TextBlock Text="Trạm đo theo thửa" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,4,0,10" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Mã thửa phải có trong lõi (bảng parcels của HTX), nếu không lõi ghi bản tin vào ingest_rejects với lý do unknown_parcel." />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="70" /><ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã thửa" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="Tên hiển thị" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Ngưỡng khô (%)" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Bật" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="70" /><ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ParcelCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding DryThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Column="3" Margin="12,0,0,0" IsChecked="{Binding Enabled}" />
                                        <Button Grid.Column="4" Style="{StaticResource RowDangerIconButton}" Content="&#xE74D;" ToolTip="Xoá"
                                                Command="{Binding DataContext.RemoveStationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
