<Window x:Class="TeaIot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ch="clr-namespace:TeaIot.App.Controls"
        Title="Tea IoT Station · Trạm cảm biến đồi chè" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <DataTemplate x:Key="FeedTemplate">
            <Border Padding="0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,10,0" CornerRadius="4" VerticalAlignment="Top"
                            Background="{Binding Tone, Converter={StaticResource Tone}}" />
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="11.5" Foreground="{StaticResource InkTertiaryBrush}" />
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Margin="0,2,0,0" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InkSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,12,0"
                            Background="{Binding IsConnected, Converter={StaticResource Tone}, ConverterParameter=bg}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource SuccessBrush}" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}" />
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource InkTertiaryBrush}" Visibility="{Binding IsConnected, Converter={StaticResource Hidden}}" />
                            <TextBlock Text="{Binding ConnectionText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding BrokerText}" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Command="{Binding ConnectCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="Ngắt kết nối" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}" />
                            <TextBlock Margin="8,0,0,0" Text="Kết nối lõi" Visibility="{Binding IsConnected, Converter={StaticResource Hidden}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding ToggleRunCommand}" Margin="0,0,8,0">
                        <Grid>
                            <TextBlock Text="Tạm dừng" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                            <TextBlock Text="Tiếp tục" Visibility="{Binding IsRunning, Converter={StaticResource Hidden}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Đo ngay" Command="{Binding StepCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding OpenSettingsCommand}" ToolTip="Cài đặt">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                        <Image Source="/Assets/logo.png" Width="28" Height="28" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tea IoT Station" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}">
                            <Run Text="{Binding HtxName, Mode=OneWay}" /><Run Text=" · trạm cảm biến đồi chè gửi dữ liệu vào lõi DX-OS qua MQTT" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connection problem -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarningSubtleBrush}" Padding="28,8"
                Visibility="{Binding ConnectionError, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ConnectionError}" FontSize="12.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- KPIs -->
            <UniformGrid Rows="1" Margin="0,0,-16,0">
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Số đo đã gửi vào lõi" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Sent}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Đang chờ gửi (mất mạng)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Pending}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Giá trị lỗi (lõi sẽ từ chối)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding RejectedLocally}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Giờ mô phỏng" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding SimTime}" Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Station cards -->
            <ItemsControl Grid.Row="1" Margin="0,16,-12,0" ItemsSource="{Binding Stations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Style="{StaticResource Card}" Padding="14,12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{Binding Tone, Converter={StaticResource Tone}}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding ParcelCode}" FontSize="11.5" Foreground="{StaticResource InkTertiaryBrush}" />
                                <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold" Foreground="{Binding Tone, Converter={StaticResource Tone}}" Text="{Binding SoilText}" />
                                <TextBlock Text="độ ẩm đất" FontSize="11.5" Foreground="{StaticResource InkSecondaryBrush}" />
                                <Border Margin="0,8,0,0" Style="{StaticResource Pill}" Background="{Binding Tone, Converter={StaticResource Tone}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource Tone}}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected station -->
            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}" DataContext="{Binding Selected}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Kịch bản" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource InkSecondaryBrush}" />
                            <ComboBox Width="190" ItemsSource="{Binding ScenarioOptions}" SelectedItem="{Binding Scenario}" />
                            <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Height="34"
                                    Command="{Binding DataContext.IrrigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB42;" Style="{StaticResource Icon}" FontSize="13" />
                                    <TextBlock Margin="8,0,0,0" Text="Bật bơm tưới" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ParcelCode, Mode=OneWay}" Foreground="{StaticResource InkTertiaryBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Topic htx/…/plot/" /><Run Text="{Binding ParcelCode, Mode=OneWay}" /><Run Text="/&lt;cảm biến&gt; · ngưỡng đất khô " /><Run Text="{Binding DryThreshold, Mode=OneWay}" /><Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl DockPanel.Dock="Top" Margin="0,14,-10,0" ItemsSource="{Binding Values}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile" Margin="0,0,10,0" Padding="12,10" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource LeafLightBrush}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="Bold">
                                                <Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Warning}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,4">
                        <TextBlock Text="Diễn biến theo giờ mô phỏng" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <Rectangle Width="14" Height="3" Fill="#176C4B" VerticalAlignment="Center" /><TextBlock Text=" Độ ẩm đất (%)" FontSize="12" Margin="0,0,12,0" />
                        <Rectangle Width="14" Height="3" Fill="#1D4ED8" VerticalAlignment="Center" /><TextBlock Text=" Độ ẩm không khí (%)" FontSize="12" Margin="0,0,12,0" />
                        <Rectangle Width="14" Height="3" Fill="#B45309" VerticalAlignment="Center" /><TextBlock Text=" Nhiệt độ (°C)" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Text="- - - ngưỡng đất khô" FontSize="12" Foreground="#B45309" />
                    </StackPanel>
                    <ch:LineChart Series="{Binding Series}" Labels="{Binding Labels}" Threshold="{Binding DryThreshold}" MinHeight="200" />
                </DockPanel>
            </Border>

            <!-- Right column: alerts and log -->
            <Grid Grid.Column="2" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Cảnh báo đồng ruộng" Style="{StaticResource SectionTitle}" />
                            <CheckBox Margin="0,8,0,4" Content="Gửi gợi ý việc sang Tea Staff Manager" IsChecked="{Binding ForwardAlerts}" FontSize="12.5" />
                        </StackPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource FeedTemplate}" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource Caption}" Text="Chưa có cảnh báo." Margin="0,8,0,0"
                                       Visibility="{Binding Alerts.Count, Converter={StaticResource Hidden}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Nhật ký kết nối" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource FeedTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
