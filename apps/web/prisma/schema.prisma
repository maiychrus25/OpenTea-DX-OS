// apps/web/prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ParcelStatus {
  SOWING
  TENDING
  HARVEST_APPROVED
  HARVESTED
  DRAFT
}

enum ActivityType {
  SOWING
  FERTILIZING
  SPRAYING
  IRRIGATION
  HARVEST
  PRUNING
  OTHER
}

enum PesticideGroup {
  BOTANICAL
  MICROBIAL
  BIOLOGICAL
  CHEMICAL
  ANTIBIOTIC
}

enum LotStatus {
  DRAFT
  READY
  QR_EXPORTED
}

enum NotificationType {
  ANNOUNCEMENT
  HARVEST_APPROVED
  DISEASE_REPORT
  JOURNAL_SUBMITTED
  JOURNAL_APPROVED
  MARKET_ALERT
  SYSTEM
  BROADCAST
}

enum PartnerType {
  BUYER
  MIDDLEMAN
  WAREHOUSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum UserRole {
  MANAGER
  OFFICER
  FARMER
}

enum DiseaseReportStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// â”€â”€â”€ HTX Profile (singleton) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model HtxProfile {
  id            String   @id @default(cuid())
  name          String
  address       String
  contact_phone String?
  contact_email String?
  crop_types    String[] // e.g. ["Chè Trung du", "Chè Kim Tuyên"]
  season_label  String? // e.g. "Lứa 1/2026"
  htx_code      String   @unique // e.g. "TC" — used in lot codes + public URL
  total_area_ha Float    @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  households         Household[]
  pesticide_labels   HtxPesticideLabel[]
  lots               Lot[]
  notifications      Notification[]
  partners           Partner[]
  memberships        HtxMembership[]
  leaf_grades        LeafGrade[]
  daily_leaf_prices  DailyLeafPrice[]
  fresh_leaf_tickets FreshLeafTicket[]
  input_items        InputItem[]
  input_advances     InputAdvance[]
  settlement_periods SettlementPeriod[]
  ledger_entries     MemberLedgerEntry[]
  processing_batches ProcessingBatch[]

  @@map("htx_profiles")
}

// â”€â”€â”€ Households â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Household {
  id                String   @id @default(cuid())
  name              String
  phone             String   @unique
  address           String?
  keycloak_user_id  String? // linked after farmer account created
  // Payout account for the settlement slip. Personal data: never sent to Telegram, agents or logs.
  bank_bin          String?
  bank_account      String?
  bank_account_name String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  parcels         Parcel[]
  disease_reports DiseaseReport[]
  notifications   Notification[]      @relation("RecipientHousehold")
  leaf_tickets    FreshLeafTicket[]
  input_advances  InputAdvance[]
  settlements     MemberSettlement[]
  ledger_entries  MemberLedgerEntry[]

  htx_profile_id String?
  htx_profile    HtxProfile? @relation(fields: [htx_profile_id], references: [id])

  @@index([htx_profile_id])
  @@map("households")
}

// â”€â”€â”€ Farm Zone â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Parcel {
  id                     String       @id @default(cuid())
  parcel_code            String       @unique // auto-generated e.g. "P-TC-001"
  household_id           String
  household              Household    @relation(fields: [household_id], references: [id])
  crop_type              String
  area_ha                Float
  centroid_lat           Float?
  centroid_lng           Float?
  polygon_geojson        Json? // GeoJSON Polygon feature
  status                 ParcelStatus @default(DRAFT)
  estimated_yield_per_ha Float?
  harvest_approved_by    String? // keycloak user ID of officer
  harvest_approved_at    DateTime?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  crop_cycles     ParcelCropCycle[]
  journal_entries JournalEntry[]
  lot_parcels     LotParcel[]
  disease_reports DiseaseReport[]
  weather_cache   WeatherCache[]
  leaf_tickets    FreshLeafTicket[]

  @@map("parcels")
}

model ParcelCropCycle {
  id                     String    @id @default(cuid())
  parcel_id              String
  parcel                 Parcel    @relation(fields: [parcel_id], references: [id])
  season                 String? // e.g. "Lứa 1/2026"
  sowed_at               DateTime?
  harvested_at           DateTime?
  estimated_harvest_date DateTime?
  created_at             DateTime  @default(now())

  journal_entries JournalEntry[]
  lot_parcels     LotParcel[]
  leaf_tickets    FreshLeafTicket[]

  @@map("parcel_crop_cycles")
}

// â”€â”€â”€ Journal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model JournalEntry {
  id              String           @id @default(cuid())
  parcel_id       String
  parcel          Parcel           @relation(fields: [parcel_id], references: [id])
  entry_date      DateTime
  activity_type   ActivityType
  performed_by    String // name string
  submitted_by_id String? // keycloak user ID
  submitted_role  UserRole
  status          String           @default("PENDING_APPROVAL")
  approved_by_id  String? // keycloak user ID of officer
  approved_at     DateTime?
  review_note     String? // reason given when an officer rejects or asks for changes
  reviewed_by_id  String? // keycloak user ID of the officer who approved, rejected or asked for changes
  notes           String?
  cycle_id        String? // plucking flush; null for parcels without cycles
  cycle           ParcelCropCycle? @relation(fields: [cycle_id], references: [id])
  client_id       String? // client-generated uuid, makes offline replays idempotent

  // Weather auto-attach
  weather_condition     String?
  weather_temperature   Float?
  weather_precipitation Float?
  weather_humidity      Float?

  // Image attachment
  photo_url       String?
  photo_minio_key String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  activities JournalActivity[]

  @@unique([submitted_by_id, client_id])
  @@index([cycle_id])
  @@map("journal_entries")
}

model JournalActivity {
  id                   String            @id @default(cuid())
  journal_entry_id     String
  journal_entry        JournalEntry      @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  activity_detail      String
  product_name         String? // for Spraying/Fertilizing
  dosage               String?
  withdrawal_days      Int? // for Spraying
  safe_harvest_date    DateTime? // entry_date + withdrawal_days
  fresh_leaf_kg        Float? // for Harvest
  pesticide_product_id String?
  pesticide_product    PesticideProduct? @relation(fields: [pesticide_product_id], references: [id])
  created_at           DateTime          @default(now())

  @@map("journal_activities")
}

// Shared pesticide catalogue; default_phi_days is the floor, an HTX label can replace it.
model PesticideProduct {
  id                    String         @id @default(cuid())
  trade_name            String         @unique
  active_ingredient     String
  group                 PesticideGroup
  targets               String[]
  default_phi_days      Int
  phi_needs_label_check Boolean        @default(true)
  source                String
  active                Boolean        @default(true)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  activities  JournalActivity[]
  labels      HtxPesticideLabel[]
  input_items InputItem[]

  @@map("pesticide_products")
}

model HtxPesticideLabel {
  id                   String           @id @default(cuid())
  htx_profile_id       String
  htx_profile          HtxProfile       @relation(fields: [htx_profile_id], references: [id])
  pesticide_product_id String
  pesticide_product    PesticideProduct @relation(fields: [pesticide_product_id], references: [id])
  label_phi_days       Int
  label_note           String?
  verified_by_id       String // Keycloak sub
  verified_at          DateTime         @default(now())
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  @@unique([htx_profile_id, pesticide_product_id])
  @@map("htx_pesticide_labels")
}

// â”€â”€â”€ Lots & QR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Lot {
  id                  String       @id @default(cuid())
  lot_code            String       @unique // e.g. "TC-CHE-20261110-001"
  commodity           String
  quality_grade       String? // "Grade 1" | "Grade 2" | "Ungraded"
  harvest_date        DateTime
  estimated_weight_kg Float?
  actual_weight_kg    Float?
  packaging_type      String?
  destination         String? // Nơi giao hàng
  buyer_name          String? // Tên người mua
  packaging_date      DateTime?
  total_weight_kg     Float?
  packaging_spec      String?
  status              LotStatus    @default(DRAFT)
  qr_image_url        String? // MinIO URL of generated QR PNG
  certificate_keys    String[]     @default([]) // MinIO object keys of attached certificates
  public_page_data    Json? // JSONB snapshot of trace data for public QR page
  dry_grade           DryTeaGrade? // null for lots made before phase 2
  created_by_id       String? // keycloak officer user ID
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  lot_parcels   LotParcel[]
  batch_sources LotBatchSource[]

  htx_profile_id String?
  htx_profile    HtxProfile? @relation(fields: [htx_profile_id], references: [id])

  @@index([htx_profile_id, status])
  @@map("lots")
}

model LotParcel {
  id        String           @id @default(cuid())
  lot_id    String
  lot       Lot              @relation(fields: [lot_id], references: [id])
  parcel_id String
  parcel    Parcel           @relation(fields: [parcel_id], references: [id])
  cycle_id  String?
  cycle     ParcelCropCycle? @relation(fields: [cycle_id], references: [id])

  @@unique([lot_id, parcel_id])
  @@map("lot_parcels")
}

// â”€â”€â”€ Notifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Notification {
  id                   String           @id @default(cuid())
  type                 NotificationType
  title                String
  body                 String
  recipient_id         String? // keycloak user ID (null = system broadcast)
  household_id         String?
  household            Household?       @relation("RecipientHousehold", fields: [household_id], references: [id])
  htx_profile_id       String? // owning HTX of a broadcast (recipient_id is null)
  htx_profile          HtxProfile?      @relation(fields: [htx_profile_id], references: [id])
  sender_id            String? // keycloak user ID of sender
  is_read              Boolean          @default(false)
  pushed_to_mattermost Boolean          @default(false) // Story 5.7: track Mattermost push status
  deep_link_url        String?
  tts_text             String? // pre-generated TTS text (summary)
  created_at           DateTime         @default(now())

  @@index([recipient_id, is_read])
  @@index([htx_profile_id])
  @@index([created_at])
  @@index([pushed_to_mattermost, type]) // n8n poll: unpushed high-priority notifications
  @@map("notifications")
}

// â”€â”€â”€ Disease Detection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model DiseaseReport {
  id                       String              @id @default(cuid())
  parcel_id                String
  parcel                   Parcel              @relation(fields: [parcel_id], references: [id])
  household_id             String
  household                Household           @relation(fields: [household_id], references: [id])
  detected_by_id           String // farmer keycloak user ID
  detection_date           DateTime
  photo_url                String // MinIO pre-signed URL (stored as path key)
  photo_minio_key          String // MinIO object key for generating new URLs
  gps_lat                  Float?
  gps_lng                  Float?
  ai_disease_name          String
  ai_confidence            Float
  confirmed_diagnosis      String?
  confirmed_by_id          String? // officer keycloak user ID
  confirmed_at             DateTime?
  treatment_notes          String? // officer-internal only, never shown to farmer
  treatment_recommendation String? // farmer-visible treatment advice
  status                   DiseaseReportStatus @default(PENDING)
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  @@map("disease_reports")
}

// â”€â”€â”€ Market & Economic Data (n8n writes, Next.js reads) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MarketData {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String // "USDA" | "WTO" | "FAOSTAT" | "NASA"
  commodity  String
  metric     String // "export_price" | "import_tariff" | "production_volume"
  value      Float
  unit       String
  period     String // "2026-07" or "2026" or "2026-W30"
  fetched_at DateTime @default(now())

  @@unique([source, commodity, metric, period])
  @@index([commodity, fetched_at])
  @@map("market_data")
}

model Bulletin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commodity    String
  bulletin_vi  String   @db.Text
  sources_json Json // [{source, metric, value, date}]
  model_used   String
  is_latest    Boolean  @default(false)
  status       String   @default("published") // draft | published | rejected, checked in the migration
  htx_code     String? // owning cooperative; null is a shared bulletin written by the n8n workflow
  created_at   DateTime @default(now())

  @@index([commodity, is_latest])
  @@index([htx_code, commodity, is_latest])
  @@map("bulletins")
}

model FxRate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rates      Json     @db.JsonB
  fetched_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("fx_rates")
}

model WeatherCache {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parcel_id        String
  parcel           Parcel   @relation(fields: [parcel_id], references: [id])
  recorded_at      DateTime // hour-truncated timestamp
  condition        String
  temperature_c    Float
  precipitation_mm Float
  humidity_pct     Float
  source           String   @default("open-meteo")
  forecast_json    Json?

  @@unique([parcel_id, recorded_at])
  @@map("weather_cache")
}

// â”€â”€â”€ Partner Map â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Partner {
  id                  String      @id @default(cuid())
  name                String
  partner_type        PartnerType
  contact_phone       String?
  primary_commodities String[]
  lat                 Float
  lng                 Float
  address             String?
  htx_profile_id      String? // null rows belong to no cooperative and are invisible
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  htx_profile HtxProfile? @relation(fields: [htx_profile_id], references: [id])

  @@index([htx_profile_id])
  @@map("partners")
}

// â”€â”€â”€ Chat History â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ChatHistory {
  id           String   @id @default(cuid())
  session_id   String
  user_id      String // keycloak user ID
  role         ChatRole
  content      String   @db.Text
  sources_json Json? // [{source, date, url}]
  chat_type    String // "market" | "technical"
  created_at   DateTime @default(now())

  @@index([session_id, created_at])
  @@index([user_id, created_at])
  @@map("chat_history")
}

// ─── Memberships (S2) ───

/// The roles a person holds in one HTX. Keycloak realm roles stay the source of truth; this row is synced from the token.
model HtxMembership {
  id               String     @id @default(cuid())
  keycloak_user_id String
  htx_profile_id   String
  roles            String[] // subset of farmer, officer, accountant, manager
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  htx_profile      HtxProfile @relation(fields: [htx_profile_id], references: [id])

  @@unique([keycloak_user_id, htx_profile_id])
  @@index([htx_profile_id])
  @@map("htx_memberships")
}

// ─── Weighing station ───────────────────────────────────────────────────────

model LeafGrade {
  id             String     @id @default(cuid())
  htx_profile_id String
  htx_profile    HtxProfile @relation(fields: [htx_profile_id], references: [id])
  name           String
  sort_order     Int        @default(0)
  active         Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  prices  DailyLeafPrice[]
  tickets FreshLeafTicket[]

  @@unique([htx_profile_id, name])
  @@map("leaf_grades")
}

// One price per grade and Vietnam calendar day; a ticket copies the price when it is written.
model DailyLeafPrice {
  id               String     @id @default(cuid())
  htx_profile_id   String
  htx_profile      HtxProfile @relation(fields: [htx_profile_id], references: [id])
  grade_id         String
  grade            LeafGrade  @relation(fields: [grade_id], references: [id])
  price_date       DateTime   @db.Date
  price_vnd_per_kg Int
  published_by_id  String // Keycloak sub
  published_at     DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@unique([grade_id, price_date])
  @@index([htx_profile_id, price_date])
  @@map("daily_leaf_prices")
}

enum LeafTicketStatus {
  VALID
  VOIDED
}

// Immutable once written: a wrong ticket is voided and weighed again.
model FreshLeafTicket {
  id                  String            @id @default(cuid())
  htx_profile_id      String
  htx_profile         HtxProfile        @relation(fields: [htx_profile_id], references: [id])
  ticket_no           String            @unique // {HTX_CODE}-PC-{YYYYMMDD}-{NNN}
  household_id        String
  household           Household         @relation(fields: [household_id], references: [id])
  parcel_id           String
  parcel              Parcel            @relation(fields: [parcel_id], references: [id])
  cycle_id            String? // null for a parcel without any flush (legacy data)
  cycle               ParcelCropCycle?  @relation(fields: [cycle_id], references: [id])
  grade_id            String
  grade               LeafGrade         @relation(fields: [grade_id], references: [id])
  weighed_at          DateTime
  gross_kg            Decimal           @db.Decimal(7, 1)
  deduction_pct       Decimal           @db.Decimal(4, 1)
  net_kg              Decimal           @db.Decimal(7, 1)
  price_vnd_per_kg    Int
  amount_vnd          BigInt
  status              LeafTicketStatus  @default(VALID)
  void_reason         String?
  voided_by_id        String?
  voided_at           DateTime?
  created_by_id       String // Keycloak sub
  client_id           String? // client-generated uuid, makes replays idempotent
  settlement_id       String?
  settlement          MemberSettlement? @relation(fields: [settlement_id], references: [id], onDelete: Restrict)
  processing_batch_id String?
  processing_batch    ProcessingBatch?  @relation(fields: [processing_batch_id], references: [id], onDelete: Restrict)
  created_at          DateTime          @default(now())

  @@unique([created_by_id, client_id])
  @@index([processing_batch_id])
  @@index([htx_profile_id, weighed_at])
  @@index([household_id])
  @@index([parcel_id])
  @@index([cycle_id])
  @@map("fresh_leaf_tickets")
}

// ─── Input advances, member ledger and settlement (S4) ──────────────────────

enum InputKind {
  FERTILIZER
  PESTICIDE
  OTHER
}

enum SettlementStatus {
  DRAFT
  CLOSED
}

enum LedgerEntryType {
  LEAF_CREDIT
  INPUT_DEBIT
  PAYOUT
  ADJUSTMENT
}

enum PaymentMethod {
  TRANSFER
  CASH
}

model InputItem {
  id                   String            @id @default(cuid())
  htx_profile_id       String
  htx_profile          HtxProfile        @relation(fields: [htx_profile_id], references: [id])
  name                 String
  unit                 String
  unit_price_vnd       Int
  kind                 InputKind
  pesticide_product_id String?
  pesticide_product    PesticideProduct? @relation(fields: [pesticide_product_id], references: [id])
  active               Boolean           @default(true)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  advances InputAdvance[]

  @@unique([htx_profile_id, name])
  @@map("input_items")
}

// Immutable once written: a wrong advance is voided and entered again. The price is copied from the item.
model InputAdvance {
  id             String            @id @default(cuid())
  htx_profile_id String
  htx_profile    HtxProfile        @relation(fields: [htx_profile_id], references: [id])
  advance_no     String            @unique // {HTX_CODE}-VT-{YYYYMMDD}-{NNN}
  household_id   String
  household      Household         @relation(fields: [household_id], references: [id])
  item_id        String
  item           InputItem         @relation(fields: [item_id], references: [id])
  quantity       Decimal           @db.Decimal(9, 2)
  unit_price_vnd Int
  amount_vnd     BigInt
  advanced_on    DateTime          @db.Date
  status         LeafTicketStatus  @default(VALID)
  void_reason    String?
  voided_by_id   String?
  voided_at      DateTime?
  settlement_id  String?
  settlement     MemberSettlement? @relation(fields: [settlement_id], references: [id], onDelete: Restrict)
  client_id      String? // client-generated uuid, makes replays idempotent
  created_by_id  String // Keycloak sub
  created_at     DateTime          @default(now())

  @@unique([created_by_id, client_id])
  @@index([htx_profile_id, advanced_on])
  @@index([household_id])
  @@map("input_advances")
}

model SettlementPeriod {
  id              String           @id @default(cuid())
  htx_profile_id  String
  htx_profile     HtxProfile       @relation(fields: [htx_profile_id], references: [id])
  code            String           @unique // {HTX_CODE}-QT-{YYYYMMDD of date_to}
  date_from       DateTime         @db.Date
  date_to         DateTime         @db.Date
  status          SettlementStatus @default(DRAFT)
  created_by_id   String // Keycloak sub
  created_by_name String? // display name at that time; Keycloak is not queried when a page is read
  created_at      DateTime         @default(now())
  closed_by_id    String?
  closed_by_name  String?
  closed_at       DateTime?

  lines MemberSettlement[]

  @@index([htx_profile_id, date_from])
  @@map("settlement_periods")
}

// One line per household with activity in the period; written only when the period is closed.
model MemberSettlement {
  id              String           @id @default(cuid())
  period_id       String
  period          SettlementPeriod @relation(fields: [period_id], references: [id])
  household_id    String
  household       Household        @relation(fields: [household_id], references: [id])
  leaf_net_kg     Decimal          @db.Decimal(10, 1)
  leaf_amount_vnd BigInt
  advances_vnd    BigInt
  debt_in_vnd     BigInt
  payable_vnd     BigInt
  debt_out_vnd    BigInt
  paid_at         DateTime?
  paid_by_id      String?
  payment_method  PaymentMethod?
  payment_ref     String?

  tickets        FreshLeafTicket[]
  advances       InputAdvance[]
  ledger_entries MemberLedgerEntry[]

  @@unique([period_id, household_id])
  @@index([household_id])
  @@map("member_settlements")
}

// Append-only (a database trigger refuses UPDATE and DELETE). Positive: the HTX owes the household. Negative: the household owes the HTX.
model MemberLedgerEntry {
  id             String            @id @default(cuid())
  htx_profile_id String
  htx_profile    HtxProfile        @relation(fields: [htx_profile_id], references: [id])
  household_id   String
  household      Household         @relation(fields: [household_id], references: [id])
  entry_type     LedgerEntryType
  amount_vnd     BigInt
  ticket_id      String?
  advance_id     String?
  settlement_id  String?
  settlement     MemberSettlement? @relation(fields: [settlement_id], references: [id], onDelete: Restrict)
  note           String?
  created_by_id  String // Keycloak sub
  created_at     DateTime          @default(now())

  @@index([household_id, created_at])
  @@map("member_ledger_entries")
}

enum ProcessingBatchStatus {
  OPEN
  FINISHED
  CANCELLED
}

enum DryTeaGrade {
  DINH
  TOM_NON
  MOC_CAU
  BOM
  CAM
}

model ProcessingBatch {
  id              String                @id @default(cuid())
  htx_profile_id  String
  htx_profile     HtxProfile            @relation(fields: [htx_profile_id], references: [id])
  batch_code      String                @unique // {HTX_CODE}-MS-{YYYYMMDD}-{NN}
  processed_on    DateTime              @db.Date
  status          ProcessingBatchStatus @default(OPEN)
  master_name     String?
  shift           String?
  notes           String?
  fresh_kg        Decimal?              @db.Decimal(10, 1)
  dry_kg          Decimal?              @db.Decimal(10, 1)
  recovery_ratio  Decimal?              @db.Decimal(5, 2)
  out_of_band     Boolean               @default(false)
  deviation_note  String?
  created_by_id   String
  created_at      DateTime              @default(now())
  finished_by_id  String?
  finished_at     DateTime?
  cancelled_by_id String?
  cancelled_at    DateTime?
  cancel_reason   String?

  tickets FreshLeafTicket[]
  outputs ProcessingBatchOutput[]

  @@index([htx_profile_id, processed_on])
  @@map("processing_batches")
}

model ProcessingBatchOutput {
  id       String          @id @default(cuid())
  batch_id String
  batch    ProcessingBatch @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  grade    DryTeaGrade
  kg       Decimal         @db.Decimal(9, 1)

  lot_sources LotBatchSource[]

  @@unique([batch_id, grade])
  @@map("processing_batch_outputs")
}

model LotBatchSource {
  id        String                @id @default(cuid())
  lot_id    String
  lot       Lot                   @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  output_id String
  output    ProcessingBatchOutput @relation(fields: [output_id], references: [id], onDelete: Restrict)
  kg        Decimal               @db.Decimal(9, 1)

  @@unique([lot_id, output_id])
  @@index([output_id])
  @@map("lot_batch_sources")
}
