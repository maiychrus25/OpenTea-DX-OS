<UserControl x:Class="TeaStaff.Desktop.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Current status reported by the employee -->
        <Border Padding="14,12" Margin="0,0,0,16" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource LeafLightBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Visibility="{Binding IsExisting, Converter={StaticResource Visible}}">
            <StackPanel>
                <DockPanel>
                    <ContentControl DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" />
                    <TextBlock Text="Tình trạng do nhân viên báo" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Margin="0,10,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                <TextBlock Margin="0,8,0,0" Text="{Binding ReportNote, TargetNullValue='Chưa có báo cáo.'}" Style="{StaticResource Caption}" />
            </StackPanel>
        </Border>

        <TextBlock Text="Tên công việc *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Giao cho *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee}" MaxDropDownHeight="300" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Mức ưu tiên" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,14,0,0" Text="Địa điểm (đồi, thửa, xưởng…)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Bắt đầu" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding StartDate}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Giờ" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="Hạn hoàn thành" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DueDate}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Giờ" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding DueTime, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,14,0,0" Text="Mô tả, yêu cầu kỹ thuật" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="96" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="Nhân viên thấy việc này ngay trên ứng dụng điện thoại, có thể nhận, báo tiến độ hoặc từ chối kèm lý do." />
    </StackPanel>
</UserControl>
