<UserControl x:Class="TeaStaff.Desktop.Views.PayslipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Line" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Amount" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="LineLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel>
            <ContentControl DockPanel.Dock="Right" Content="{Binding Slip.Status}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="{Binding EmployeeLine}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding HtxName}" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>

        <Border Margin="0,14,0,0" Padding="16,14" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource LeafLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel Style="{StaticResource Line}">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.BaseSalary, Converter={StaticResource Money}}" />
                    <TextBlock Style="{StaticResource LineLabel}" Text="{Binding Slip.SalaryType, Converter={StaticResource Label}, StringFormat='Lương cơ bản ({0})'}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Line}">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.EarnedSalary, Converter={StaticResource Money}}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource LineLabel}" Text="Lương theo ngày công" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding DaysLine}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{StaticResource Line}">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.OvertimePay, Converter={StaticResource Money}}" />
                    <TextBlock Style="{StaticResource LineLabel}" Text="{Binding Slip.OvertimeHours, StringFormat='Tăng ca ({0:0.#} giờ)'}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Line}">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.Insurance, Converter={StaticResource Money}, StringFormat='− {0}'}" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Style="{StaticResource LineLabel}" Text="Bảo hiểm bắt buộc" />
                </DockPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,8" />
                <DockPanel Style="{StaticResource Line}">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.GrossPay, Converter={StaticResource Money}}" />
                    <TextBlock Style="{StaticResource LineLabel}" Text="Tổng thu nhập" />
                </DockPanel>
                <DockPanel Margin="0">
                    <TextBlock Style="{StaticResource Amount}" Text="{Binding Slip.NetPay, Converter={StaticResource Money}}" FontSize="18" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                    <TextBlock Text="Thực lĩnh" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,10" Text="Điều chỉnh (₫)" Style="{StaticResource SectionTitle}" />
        <UniformGrid Columns="4" IsEnabled="{Binding IsEditable}">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Phụ cấp" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Allowance, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Thưởng" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Bonus, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Khấu trừ khác" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Deduction, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Tạm ứng" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Advance, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
            </StackPanel>
        </UniformGrid>
        <TextBlock Margin="0,14,0,0" Text="Ghi chú trên phiếu lương" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" MaxLength="200" />
        <DockPanel Margin="0,12,0,0" Visibility="{Binding IsEditable, Converter={StaticResource Hidden}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Trả về nháp để sửa" Command="{Binding BackToDraftCommand}" />
            <TextBlock Text="Phiếu đã duyệt hoặc đã trả nên không sửa được." Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</UserControl>
