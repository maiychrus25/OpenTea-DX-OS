<UserControl x:Class="TeaStaff.Desktop.Views.LeavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:TeaStaff.Core.Domain;assembly=TeaStaff.Core"
             xmlns:ch="clr-namespace:TeaStaff.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
            <Setter Property="GroupName" Value="LeaveFilter" />
            <Setter Property="Command" Value="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="Ghi đơn nghỉ" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterChip}" Tag="pending" IsChecked="True">
                    <TextBlock><Run Text="Chờ duyệt (" /><Run Text="{Binding PendingCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterChip}" Tag="approved" Content="Đã duyệt" />
                <RadioButton Style="{StaticResource FilterChip}" Tag="rejected" Content="Từ chối / Huỷ" />
                <RadioButton Style="{StaticResource FilterChip}" Tag="all" Content="Tất cả" />
            </StackPanel>
        </DockPanel>

        <!-- Leave statistics -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.6*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ngày nghỉ đã duyệt năm nay theo loại" Style="{StaticResource SectionTitle}" />
                    <Grid Height="120" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ch:DonutChart Items="{Binding TypeShare}" CenterLabel="ngày" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeLegend}" VerticalAlignment="Center" Margin="18,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FontSize="12.5" />
                                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,6,0" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ngày nghỉ theo tháng (6 tháng)" Style="{StaticResource SectionTitle}" />
                    <ch:BarChart Height="120" Margin="0,8,0,0" Items="{Binding MonthBars}" />
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đơn nghỉ ốm có minh chứng" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding EvidenceRate}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="Nghỉ ốm từ 2 ngày bắt buộc kèm ảnh hoặc PDF" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" RowHeight="60">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nhân viên" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Employee.FullName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Employee.Position}" FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Loại nghỉ" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type, Converter={StaticResource Label}}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thời gian" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{Binding FromDate, StringFormat='dd/MM/yyyy', Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding ToDate, StringFormat='dd/MM/yyyy', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" Text="{Binding Days, StringFormat='{}{0} ngày'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Lý do" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ReviewNote, StringFormat='Phản hồi: {0}'}" Visibility="{Binding ReviewNote, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Minh chứng" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" HorizontalAlignment="Left" ToolTip="{Binding AttachmentName}"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasAttachment, Converter={StaticResource Visible}}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="13" /><TextBlock Margin="6,0,0,0" Text="Xem" /></StackPanel>
                                        </Button>
                                        <TextBlock Text="—" Foreground="{StaticResource InkTertiaryBrush}" Visibility="{Binding HasAttachment, Converter={StaticResource Hidden}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Gửi từ" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source, Converter={StaticResource Label}}" VerticalAlignment="Center" Foreground="{StaticResource InkSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trạng thái" Width="1.15*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static d:LeaveStatus.Pending}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Content="Từ chối" Margin="0,0,8,0"
                                                Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Content="Duyệt"
                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource Hidden}}">
                    <TextBlock Text="&#xE709;" Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource BorderBrush}" />
                    <TextBlock Margin="0,10,0,0" Text="Không có đơn nghỉ nào trong mục này." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
