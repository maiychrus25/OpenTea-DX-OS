<UserControl x:Class="TeaStaff.Desktop.Views.RecurringTaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Tên công việc *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tổ phụ trách" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding Department}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Mức ưu tiên" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,14,0,0" Text="Người phụ trách" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee}" MaxDropDownHeight="300" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="Người phụ trách nghỉ hoặc vắng thì hệ thống chọn người hợp nhất còn rảnh." />

        <TextBlock Margin="0,14,0,0" Text="Địa điểm (đồi, thửa, xưởng…)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" />

        <TextBlock Margin="0,14,0,0" Text="Lặp vào các ngày" Style="{StaticResource FieldLabel}" />
        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Giờ bắt đầu" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Giờ hạn chót" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding DueTime, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,14,0,0" Text="Mô tả, yêu cầu kỹ thuật" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="72" />

        <CheckBox Margin="0,16,0,0" Content="Tự giao cho người hợp nhất (không cần chờ duyệt)" IsChecked="{Binding AutoAssign}" />
        <CheckBox Margin="0,10,0,0" Content="Đang bật" IsChecked="{Binding IsActive}" />
    </StackPanel>
</UserControl>
