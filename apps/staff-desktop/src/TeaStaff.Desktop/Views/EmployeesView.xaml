<UserControl x:Class="TeaStaff.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ch="clr-namespace:TeaStaff.Desktop.Controls">
    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0" ToolTip="Tìm theo tên (không cần dấu), mã, số điện thoại, chức vụ" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" FontSize="14" Foreground="{StaticResource InkTertiaryBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Tìm nhân viên…" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkTertiaryBrush}" IsHitTestVisible="False"
                           Visibility="{Binding Search, Converter={StaticResource Hidden}}" />
            </Grid>
            <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding DepartmentFilters}" SelectedItem="{Binding DepartmentFilter}" />
            <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="Xuất CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="Thêm nhân viên" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Workforce structure -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.7*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nhân viên đang làm theo tổ" Style="{StaticResource SectionTitle}" />
                    <Grid Height="130" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ch:DonutChart Items="{Binding TeamShare}" CenterLabel="người" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TeamLegend}" VerticalAlignment="Center" Margin="18,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3,16,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FontSize="12.5" />
                                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,6,0" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Theo loại hợp đồng" Style="{StaticResource SectionTitle}" />
                    <ch:BarChart Height="130" Margin="0,8,0,0" Items="{Binding ContractBars}" />
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,14" Background="{StaticResource PrimarySubtleBrush}" BorderBrush="#BBD7C4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quỹ lương cơ bản / tháng" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding SalaryFund}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Lương tháng + phụ cấp của nhân viên đang làm (chưa gồm lương ngày công)" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                </Border>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="56">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding Selected}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nhân viên" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimarySubtleBrush}">
                                            <TextBlock Text="{Binding FullName, Converter={StaticResource Initials}}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}">
                                                <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Gender, Converter={StaticResource Label}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tổ · Chức vụ" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Position}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Department.Name, FallbackValue='Chưa phân tổ', TargetNullValue='Chưa phân tổ'}" FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Điện thoại" Width="1.2*" Binding="{Binding Phone}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Hợp đồng" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ContractType, Converter={StaticResource Label}}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" Text="{Binding HireDate, StringFormat='Từ {0:dd/MM/yyyy}'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Lương cơ bản" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BaseSalary, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" Text="{Binding SalaryType, Converter={StaticResource Label}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trạng thái" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tài khoản app" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Username, TargetNullValue='—'}" FontFamily="Consolas" Foreground="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="124">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RowIconButton}" Content="&#xE70F;" ToolTip="Sửa hồ sơ"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowIconButton}" Content="&#xE8D7;" ToolTip="Đặt lại mật khẩu ứng dụng điện thoại"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowDangerIconButton}" Content="&#xE74D;" ToolTip="Xoá hồ sơ"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
