<UserControl x:Class="TeaStaff.Desktop.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:TeaStaff.Core.Domain;assembly=TeaStaff.Core">
    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="Xuất CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PayAllCommand}" Margin="0,0,10,0" Content="Ghi nhận đã trả" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ApproveAllCommand}" Margin="0,0,10,0" Content="Duyệt bảng lương" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EF;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="Tính lương" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Width="38" Padding="0" Command="{Binding PreviousMonthCommand}" ToolTip="Tháng trước">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="13" />
                </Button>
                <TextBlock Text="{Binding MonthLabel}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0" MinWidth="120" TextAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Width="38" Padding="0" Command="{Binding NextMonthCommand}" ToolTip="Tháng sau">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="13" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Totals -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Tổng thu nhập" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding TotalGross}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Bảo hiểm khấu trừ" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding TotalInsurance}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12" Background="{StaticResource PrimarySubtleBrush}" BorderBrush="#BBD7C4">
                <StackPanel>
                    <TextBlock Text="Tổng thực lĩnh" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding TotalNet}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusSummary}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding PolicyText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" x:Name="Grid" RowHeight="54">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nhân viên" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Employee.FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}">
                                            <Run Text="{Binding Employee.Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SalaryType, Converter={StaticResource Label}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Lương cơ bản" Width="1.1*" Binding="{Binding BaseSalary, Converter={StaticResource Money}}" ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTemplateColumn Header="Công" Width="0.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Run Text="{Binding WorkDays, StringFormat='0.#', Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" + " Foreground="{StaticResource InkTertiaryBrush}" /><Run Text="{Binding PaidLeaveDays, StringFormat='0.#', Mode=OneWay}" Foreground="{StaticResource InfoBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Theo công" Width="1.1*" Binding="{Binding EarnedSalary, Converter={StaticResource Money}}" ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTextColumn Header="Tăng ca" Width="0.9*" Binding="{Binding OvertimePay, Converter={StaticResource Money}}" ElementStyle="{StaticResource CellNumber}" />
                        <DataGridTemplateColumn Header="Phụ cấp, thưởng" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Allowance, Converter={StaticResource Money}}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Bonus, Converter={StaticResource Money}, StringFormat='+ {0}'}" FontSize="12" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Khấu trừ" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Insurance, Converter={StaticResource Money}, StringFormat='BH {0}'}" HorizontalAlignment="Right" FontSize="12.5" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right">
                                            <Run Text="− " /><Run Text="{Binding Deduction, Converter={StaticResource Money}, Mode=OneWay}" /><Run Text=" · TƯ " /><Run Text="{Binding Advance, Converter={StaticResource Money}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thực lĩnh" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NetPay, Converter={StaticResource Money}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Trạng thái" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" Margin="10,0,0,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RowIconButton}" Content="&#xE70F;" ToolTip="Xem / điều chỉnh phiếu lương"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowIconButton}">
                                                    <Setter Property="Content" Value="&#xE73E;" />
                                                    <Setter Property="ToolTip" Value="Duyệt phiếu" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static d:PayslipStatus.Approved}">
                                                            <Setter Property="Content" Value="&#xE8C7;" />
                                                            <Setter Property="ToolTip" Value="Ghi nhận đã trả" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static d:PayslipStatus.Paid}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource BorderBrush}" />
                    <TextBlock Margin="0,10,0,0" Text="Chưa có bảng lương tháng này." FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,4,0,14" Text="Bấm Tính lương để lập phiếu từ bảng chấm công." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Tính lương ngay" Command="{Binding GenerateCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
