<UserControl x:Class="TeaStaff.Desktop.Views.DepartmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">
            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Margin="8,0,0,0" Text="Thêm tổ / phòng ban" />
                    </StackPanel>
                </Button>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource RowIconButton}" Content="&#xE70F;" ToolTip="Sửa"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowDangerIconButton}" Content="&#xE74D;" ToolTip="Xoá"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimarySubtleBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="0,14,0,0" Text="{Binding Department.Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" Text="{Binding Department.Description, TargetNullValue='Chưa có mô tả'}" Style="{StaticResource Caption}" Height="34" />
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock DockPanel.Dock="Right" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}"
                                               Text="{Binding Department.ManagerName, StringFormat='Tổ trưởng: {0}', TargetNullValue=''}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding EmployeeCount, StringFormat='{}{0} nhân viên'}" />
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Chưa có tổ nào. Bấm Thêm tổ / phòng ban." Style="{StaticResource Caption}" Visibility="{Binding Items.Count, Converter={StaticResource Hidden}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
