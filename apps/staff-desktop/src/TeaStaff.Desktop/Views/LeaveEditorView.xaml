<UserControl x:Class="TeaStaff.Desktop.Views.LeaveEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Nhân viên" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" MaxDropDownHeight="300" />
        <TextBlock Text="{Binding Remaining}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        <TextBlock Margin="0,14,0,0" Text="Loại nghỉ" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Từ ngày" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding FromDate}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding ToDate}" />
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,14,0,0" Text="Lý do *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
        <TextBlock Margin="0,14,0,0" Text="Minh chứng (giấy khám bệnh, thiệp mời…)" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Bỏ" Command="{Binding ClearAttachmentCommand}" Visibility="{Binding AttachmentFile, Converter={StaticResource Visible}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding PickAttachmentCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="13" /><TextBlock Margin="8,0,0,0" Text="Chọn tệp" /></StackPanel>
            </Button>
            <Border Height="38" Padding="12,0" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource LeafLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <TextBlock Text="{Binding AttachmentLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkSecondaryBrush}" />
            </Border>
        </DockPanel>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="Đơn do chủ HTX ghi được duyệt ngay và ghi vào bảng chấm công (bỏ qua Chủ nhật)." />
    </StackPanel>
</UserControl>
