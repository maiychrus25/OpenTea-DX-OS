<UserControl x:Class="TeaStaff.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <!-- KPI cards -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,16,0" Cursor="Hand" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Target}" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Style="{StaticResource Card}" Padding="18,16">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource InkSecondaryBrush}" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Value}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimarySubtleBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" FontSize="17" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tasks needing attention -->
                <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="20,16,16,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="32" Content="Xem tất cả" Command="{Binding OpenCommand}" CommandParameter="tasks" />
                            <StackPanel>
                                <TextBlock Text="Việc cần chú ý" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Ưu tiên việc quá hạn và khẩn cấp" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UrgentTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Assignee.FullName, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="Hạn" />
                                                    <Run Text="{Binding DueDate, StringFormat='dd/MM HH:mm', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                                <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource InkTertiaryBrush}" Text="{Binding Progress, StringFormat='{}{0}% hoàn thành'}" />
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="20,4,20,20" Text="Không có việc nào đang mở. Bấm Giao việc để bắt đầu." Style="{StaticResource Caption}"
                                   Visibility="{Binding UrgentTasks.Count, Converter={StaticResource Hidden}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Attendance today -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Chấm công hôm nay" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                                <TextBlock Text="{Binding PresentToday}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding ActiveEmployees, StringFormat=' / {0} người có mặt'}" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,6" Foreground="{StaticResource InkSecondaryBrush}" />
                            </StackPanel>
                            <ProgressBar Value="{Binding PresentRatio, Mode=OneWay}" Maximum="1" Height="8" />
                            <Button Margin="0,14,0,0" Style="{StaticResource SecondaryButton}" Content="Mở bảng chấm công" Command="{Binding OpenCommand}" CommandParameter="attendance" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Pending leaves -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="30" Content="Duyệt" Command="{Binding OpenCommand}" CommandParameter="leaves" />
                                <TextBlock Text="Đơn nghỉ chờ duyệt" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PendingLeaves}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Employee.FullName}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock FontSize="12" Foreground="{StaticResource InkTertiaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Type, Converter={StaticResource Label}, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding FromDate, StringFormat='dd/MM', Mode=OneWay}" />
                                                    <Run Text="–" />
                                                    <Run Text="{Binding ToDate, StringFormat='dd/MM', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Không có đơn nào đang chờ." Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding PendingLeaves.Count, Converter={StaticResource Hidden}}" />
                        </StackPanel>
                    </Border>

                    <!-- Department progress -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Tiến độ theo tổ" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Departments}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource InkTertiaryBrush}">
                                                    <Run Text="{Binding Done, Mode=OneWay}" /><Run Text=" xong · " /><Run Text="{Binding Open, Mode=OneWay}" /><Run Text=" đang làm" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Margin="0,6,0,0" Value="{Binding Ratio, Mode=OneWay}" Maximum="1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
