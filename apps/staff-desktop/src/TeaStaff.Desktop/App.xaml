<Application x:Class="TeaStaff.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeaStaff.Desktop.ViewModels"
             xmlns:v="clr-namespace:TeaStaff.Desktop.Views"
             xmlns:c="clr-namespace:TeaStaff.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:EnumLabelConverter x:Key="Label" />
            <c:StatusToneConverter x:Key="Tone" />
            <c:BoolToVisibilityConverter x:Key="Visible" />
            <c:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <c:MoneyConverter x:Key="Money" />
            <c:InitialsConverter x:Key="Initials" />
            <c:DateOnlyConverter x:Key="DateOnly" />

            <!-- Status pill: <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource PillTemplate}" /> -->
            <DataTemplate x:Key="PillTemplate">
                <Border Style="{StaticResource Pill}" Background="{Binding Converter={StaticResource Tone}, ConverterParameter=bg}">
                    <TextBlock Text="{Binding Converter={StaticResource Label}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding Converter={StaticResource Tone}, ConverterParameter=fg}" />
                </Border>
            </DataTemplate>

            <!-- Page view models -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EmployeesViewModel}"><v:EmployeesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}"><v:DepartmentsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}"><v:TasksView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AttendanceViewModel}"><v:AttendanceView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LeavesViewModel}"><v:LeavesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PayrollViewModel}"><v:PayrollView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AutomationViewModel}"><v:AutomationView /></DataTemplate>

            <!-- Editor view models -->
            <DataTemplate DataType="{x:Type vm:EmployeeEditorViewModel}"><v:EmployeeEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DepartmentEditorViewModel}"><v:DepartmentEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TaskEditorViewModel}"><v:TaskEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AttendanceEditorViewModel}"><v:AttendanceEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LeaveEditorViewModel}"><v:LeaveEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PayslipEditorViewModel}"><v:PayslipEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecurringTaskEditorViewModel}"><v:RecurringTaskEditorView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
